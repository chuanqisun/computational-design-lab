{
  "name": "moodboard-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && npm run build:apps && npm run build:prompt-library && npm run build:canvas-guide",
    "build:apps": "vite build",
    "build:prompt-library": "vite build --config vite-prompt-library.config.ts --emptyOutDir=false",
    "build:canvas-guide": "vite build --config vite-canvas-guide.config.ts --emptyOutDir=false",
    "preview": "vite preview",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@google/genai": "^3.6.0",
    "@streamparser/json": "^0.0.26",
    "@types/node": "^26.6.6",
    "idb": "^8.0.4",
    "lit-html": "^3.3.3",
    "openai": "^7.60.0",
    "rxjs": "^7.8.2"
  }
}